{
  "name": "git-course",
  "version": "0.4.0",
  "description": "Repository for practical assingments in software construction",
  "homepage": "https://github.com/FLEI-byte/GIT-Course#readme",
  "bugs": {
    "url": "https://github.com/FLEI-byte/GIT-Course/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FLEI-byte/GIT-Course.git"
  },
  "license": "ISC",
  "author": "Vlada",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "commitlint": "^21.2.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
